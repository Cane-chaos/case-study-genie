<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Root" style="flex-grow: 1; flex-direction: row; width: 100%; height: 100%;">
        <ui:VisualElement name="MainContent" style="flex-grow: 1; flex-direction: column;">
            <ui:VisualElement name="BottomPanel" style="flex-grow: 1; align-self: flex-end; background-color: rgb(0, 0, 0); height: 150px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="LeftPanel" style="flex-grow: 1; background-color: rgb(63, 63, 164); width: 250px; height: 100px; border-top-width: 20px; border-right-width: 20px; border-bottom-width: 20px; border-left-width: 20px;"/>
    </ui:VisualElement>
</ui:UXML>
