/* ── HEADER BAR ── */
.unity-tab-view__header-container {
    flex-direction: row;
    height: 60px;
    background-color: #3c3c3c;
    border-bottom-width: 1px;
    border-bottom-color: #222;
    padding-left: 0;
    padding-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
}

/* ── MỖI TAB (inactive) ── */
.unity-tab__header {
    flex-grow: 0;
    flex-shrink: 0;
    height: 100%;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 0;
    padding-bottom: 0;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    justify-content: center;
    align-items: center;
    background-color: #5a5a5a;
    color: #cccccc;
    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 0;
    border-top-color: #444;
    border-left-color: #444;
    border-right-color: #222;
    border-bottom-color: rgb(0,0,0);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
}

/* ── HOVER ── */
.unity-tab__header:hover {
    background-color: #6a6a6a;
    color: #ffffff;
}

/* ── ACTIVE TAB ── */
.unity-tab__header:checked {
    background-color: #4a90d9;
    color: #ffffff;
    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 0;
    border-top-color: #5aaaf0;
    border-left-color: #3a7abf;
    border-right-color: #3a7abf;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
}

/* ── LABEL CHỮ TRONG TAB ── */
.unity-tab__header-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: #cccccc;   /* thay inherit → giá trị màu thực */
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
}

/* ── CONTENT CONTAINER ── */
.unity-tab-view__content-container {
    flex-grow: 1;
    background-color: #ffffff;
    border-top-width: 1px;
    border-top-color: #222;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    padding-right: 5px;
    align-items: center;
}

/* ── LABEL inactive ── */
.unity-tab__header-label {
    font-size: 30px;
    -unity-font-style: bold;
    color: #cccccc;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
}

/* --- HIỆU ỨNG CHO NÚT LOGIN --- */
#loginbtn {
    background-color: rgb(0, 110, 210);
    color: white;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    padding-right: 10px;
    transition-duration: 0.2s;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    margin-top: 15px;
}

/* Hover: Nút sáng lên và nhích nhẹ lên */
#loginbtn:hover {
    background-color: rgb(0, 130, 240);
    scale: 1.5;
}
#registerbtn:hover {
    background-color: rgb(0, 130, 240);
    scale: 1.5;
}
#loginbtnregister:hover {
    background-color: rgb(0, 130, 240);
    scale: 1.2;
}
#gotoregisterlogin:hover {
    background-color: rgb(0, 130, 240);
    scale: 1.2;
}
