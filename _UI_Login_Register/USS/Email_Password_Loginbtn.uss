/* --- HIỆU ỨNG CHO NÚT LOGIN --- */
#loginbtn {
    background-color: rgb(0, 110, 210);
    color: white;
    border-radius: 8px;
    padding: 10px;
    transition-duration: 0.2s;
    border-width: 0;
    margin-top: 15px;
}

/* Hover: Nút sáng lên và nhích nhẹ lên */
#loginbtn:hover {
    background-color: rgb(0, 130, 240);
    scale: 1.5;
}

/* Active: Khi nhấn vào nút co lại một chút */
#loginbtn:active {
    background-color: rgb(0, 90, 180);
    scale: 0.98;
}

/* --- HIỆU ỨNG CHO TEXTFIELD (Email/Password) --- */
#usernamefield, #passwordfield {
    margin-bottom: 10px;
    transition-property: border-color, background-color;
    transition-duration: 0.3s;
}

/* Tùy chỉnh ô input bên trong TextField */
#usernamefield .unity-base-field__input, 
#passwordfield .unity-base-field__input {
    background-color: rgb(240, 240, 240);
    border-width: 1.5px;
    border-color: rgb(200, 200, 200);
    border-radius: 5px;
    padding: 5px;
    color: rgb(50, 50, 50);
}

/* Khi Click vào ô (Focus): Viền đổi màu và nền sáng lên */
#usernamefield .unity-base-field__input:focus, 
#passwordfield .unity-base-field__input:focus {
    border-color: rgb(0, 110, 210);
    background-color: rgb(255, 255, 255);
    /* Tạo hiệu ứng bóng đổ nhẹ phía dưới */
    border-bottom-width: 3px;
}
